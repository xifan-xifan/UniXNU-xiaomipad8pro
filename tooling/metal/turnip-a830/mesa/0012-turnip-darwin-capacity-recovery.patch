+
+/* Opt-in frontend census, in bytes. The device-list lock pins the selected
+ * retire state until the snapshot finishes; finish removes it before freeing.
+ * Fields: VA used/total/largest/holes, heap used/total, cached bytes,
+ * pending count, retries/wins, reclaim asked/seen, latched failure, version. */
+extern "C" __attribute__((visibility("default"))) bool tu_darwin_capacity_counts(uint64_t out[14]);
+extern "C" __attribute__((visibility("default"))) bool
+tu_darwin_capacity_counts(uint64_t out[14])
+{
+   if (!out)
+      return false;
+   memset(out, 0, 14 * sizeof(*out));
+   pthread_mutex_lock(&darwin_devices_lock);
+   struct darwin_retire_state *retire = NULL;
+   for (unsigned i = 0; i < ARRAY_SIZE(darwin_devices); ++i)
+      if (darwin_devices[i]) {
+         retire = darwin_devices[i];
+         break;
+      }
+   if (retire) {
+      struct tu_device *dev = retire->dev;
+      mtx_lock(&dev->vma_mutex);
+      out[0] = retire->va.used;
+      out[1] = dev->physical_device->va_size;
+      struct rb_node *last = rb_tree_last(&retire->va.size);
+      out[2] = last ? rb_node_data(struct darwin_va_hole, last, by_size)->size : 0;
+      out[3] = retire->va.holes;
+      mtx_unlock(&dev->vma_mutex);
+      out[4] = p_atomic_read(&dev->physical_device->heap.used);
+      out[5] = dev->physical_device->heap.size;
+      pthread_mutex_lock(&retire->lock);
+      out[6] = retire->cache_bytes;
+      out[7] = retire->count;
+      out[8] = retire->cache_stats.retries;
+      out[9] = retire->cache_stats.retry_wins;
+      out[10] = p_atomic_read(&retire->cache_stats.reclaims_asked);
+      out[11] = retire->cache_stats.reclaims_seen;
+      out[12] = retire->failure;
+      out[13] = 1;
+      pthread_mutex_unlock(&retire->lock);
+   }
+   pthread_mutex_unlock(&darwin_devices_lock);
+   return retire != NULL;
+}
