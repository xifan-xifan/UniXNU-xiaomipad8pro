+   char text[384];
+   va_list args;
+   va_start(args, format);
+   vsnprintf(text, sizeof(text), format, args);
+   va_end(args);
+   os_log(OS_LOG_DEFAULT, "%{public}s", text);
+   mesa_loge("%s", text);
