+/* The first 16 lines of a kind in this process, then the 100th, 1000th, ...: a burst stays bounded. */
+static bool
+darwin_bo_note_due(uint32_t count)
+{
+   if (count <= 16)
+      return true;
+   uint32_t mark = 100;
+   while (mark < count && mark <= UINT32_MAX / 10)
+      mark *= 10;
+   return mark == count;
+}
