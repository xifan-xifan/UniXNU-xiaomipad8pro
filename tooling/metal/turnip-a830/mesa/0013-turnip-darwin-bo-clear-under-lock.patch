+/* A boot argument's value: kern.piano_bootargs has the whole merged line (k27 0071, the ADT's tail too), kern.bootargs the line
+ * clipped at 1023 bytes (an older kernel). */
+static bool
+darwin_boot_arg(const char *key, char *value, size_t value_size)
+{
+   char args[4096] = {};
+   size_t size = sizeof(args) - 1;
+   if (sysctlbyname("kern.piano_bootargs", args, &size, NULL, 0)) {
+      size = sizeof(args) - 1;
+      if (sysctlbyname("kern.bootargs", args, &size, NULL, 0))
+         return false;
+   }
+   args[MIN2(size, sizeof(args) - 1)] = 0;
+   const size_t length = strlen(key);
+   for (const char *at = args; (at = strstr(at, key)); at += length) {
+      if ((at != args && at[-1] != ' ') || at[length] != '=')
+         continue;
+      const char *text = at + length + 1;
+      snprintf(value, value_size, "%.*s", (int)strcspn(text, " "), text);
+      return true;
+   }
+   return false;
+}
