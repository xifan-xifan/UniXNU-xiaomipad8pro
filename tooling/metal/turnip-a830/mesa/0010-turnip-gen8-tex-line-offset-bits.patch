From: upstream Mesa 7ea5e51c8a301a15202e28fef114e4c4055bc329 (Rob Clark, 2026-09-02 UTC)
Subject: [PATCH] tu: Fix gen8 TEX_LINE_OFFSET

This should be in bits.

Fixes: eee7a6fb3581 ("tu: gen8 descriptor support")
Part-of: https://gitlab.freedesktop.org/mesa/mesa/-/merge_requests/44151
(PROPOSAL ONLY - not applied; copied by the camera takeover for Claude to place
 as the next free tooling/metal/turnip-a830/mesa/00NN-*.patch)
---
--- a/src/freedreno/vulkan/tu_descriptor_set.h
+++ b/src/freedreno/vulkan/tu_descriptor_set.h
@@ -426,7 +426,8 @@ static inline void
 tu_desc_set_tex_line_offset(uint32_t *desc, uint32_t tex_line_offset)
 {
    if (CHIP >= A8XX) {
-      desc[6] = pkt_field_set(A8XX_TEX_MEMOBJ_6_TEX_LINE_OFFSET, desc[6], tex_line_offset);
+      /* TEX_LINE_OFFSET is in bits */
+      desc[6] = pkt_field_set(A8XX_TEX_MEMOBJ_6_TEX_LINE_OFFSET, desc[6], tex_line_offset * 8);
    } else {
       desc[2] = pkt_field_set(A6XX_TEX_MEMOBJ_2_PITCH, desc[2], tex_line_offset);
    }
