+   NmbTexture *handle=allocationWithReclaim("surface remap",[&]{return surfaceTextureHandle(backing,recipe,surface,plane,offset,row);});
+   if(!handle)return {};
+   return std::make_shared<NBSurfaceGeneration>(handle,backing);
+  }];
+ }
+ return (id<MTLTexture>)texture;
