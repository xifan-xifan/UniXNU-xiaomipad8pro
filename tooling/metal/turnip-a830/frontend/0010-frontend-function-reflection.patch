  NSString *padding=[@"" stringByPaddingToLength:MIN(indent,(NSUInteger)128) withString:@" " startingAtIndex:0];
  return [NSString stringWithFormat:@"%@<NBFunction: %@>",padding,_name ?: @"unnamed"];
