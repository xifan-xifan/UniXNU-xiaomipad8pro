<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- After the airportd kick, verify or provision the daily Known Network from
     /private/var/db/piano-wifi/profile and fall back to one CoreWLAN join. -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.unixnu.piano-wifi-join</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/local/libexec/piano-wifi-join</string>
  </array>
  <key>StandardOutPath</key>
  <string>/private/var/log/piano-wifi-join.log</string>
  <key>StandardErrorPath</key>
  <string>/private/var/log/piano-wifi-join.log</string>
</dict>
</plist>
