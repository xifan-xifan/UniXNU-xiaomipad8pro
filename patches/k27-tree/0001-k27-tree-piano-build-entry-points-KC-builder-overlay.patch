index 0000000..64794c4
--- /dev/null
+++ b/k27/build-native-display-piano.sh
@@ -0,0 +1,24 @@
+#!/usr/bin/env bash
+# DroidVMDisplay (overlay/kext/DroidVMDisplay, described by overlay/kext/DroidVMDisplay.json; objects in
+# out/x12377/native-kexts/DroidVMDisplay) against macOS 27's IOMobileFramebuffer/IOMobileFramebufferLegacy: its
+# IOMobileFramebufferABI.h is regenerated from the 27 collection (scripts/gen-iomfb-abi.py out/kc/kc27.bin) and must come out unchanged.
+# The kext also carries the DroidVM board's virtio-gpu transport and 3D contexts (UniXNU-droidvm package/DroidVMVirtioGpu.{h,cpp} and
+# DroidVMVirtioGpu3D.cpp at VGPU_REF, exported to out/k27/src/DroidVMVirtioGpu), whose buffers come from one contiguous allocation
+# (DROIDVM_VIRTIO_GPU_DYNAMIC: a native kext's __DATA has no room for 8 MiB), with patches/droidvm-display. Their user ABI, DroidVMVirtgpuABI.h, is NativeAdreno's:
+# run scripts/build-droidvm-gpu.py first (it exports NativeAdreno to out/x12377/src-gpu).
+set -eu
+K27=$(cd "$(dirname "$0")" && pwd); M=$(dirname "$K27"); D=$M/overlay/kext/DroidVMDisplay
+VGPU_REF=59ec0a814ea407f0f635af0ceb30d5147414ee15   # Droid-VM/UniXNU-droidvm wip/hackintosh, 2026-11-02
+ABI=$M/out/x12377/src-gpu/drivers/NativeAdreno
+[ -f $ABI/DroidVMVirtgpuABI.h ] || { echo "no $ABI/DroidVMVirtgpuABI.h: run scripts/build-droidvm-gpu.py first"; exit 1; }
+python3 $M/scripts/gen-iomfb-abi.py $M/out/kc/kc27.bin $D/IOMobileFramebufferABI.h
+git -C $M diff --stat -- $D/IOMobileFramebufferABI.h   # piano: 27.0.1 的 KC，ABI 头允许与仓库（27.2）不同
+V=$M/out/k27/src/DroidVMVirtioGpu; mkdir -p $V
+for name in DroidVMVirtioGpu.h DroidVMVirtioGpu.cpp DroidVMVirtioGpu3D.cpp; do
+  git -C $M/sources/UniXNU-droidvm show $VGPU_REF:package/$name > $V/$name
+done
+for patch in $M/patches/droidvm-display/*.patch; do patch -p1 -s --batch -d $V -i $patch || { echo "$patch does not apply"; exit 1; }; done
+python3 $M/overlay-piano/display-wc.py $V/DroidVMVirtioGpu3D.cpp
+cd $M
+python3 scripts/build-native-kext.py DroidVMDisplay $D/DroidVMDisplay.cpp $V/DroidVMVirtioGpu.cpp $V/DroidVMVirtioGpu3D.cpp overlay/kext/NativeKextGlue.cpp \
+  -I $D -I $V -I $ABI -D DROIDVM_VIRTIO_GPU_DYNAMIC=1 --obj k27-obj
diff --git a/k27/kc-build27-piano.py b/k27/kc-build27-piano.py
new file mode 100644
index 0000000..e469c46
--- /dev/null
+++ b/k27/kc-build27-piano.py
@@ -0,0 +1,48 @@
+#!/usr/bin/env python3
+# piano: KEPT_POINTER_REBINDS 用 27.0.1 (26A434) kernelcache 里 AMFI __DATA_CONST,__got 的第二格 0xfffffe0007b439c8（原文件是 27.2 的地址）
+"""scripts/kc-build.py for the macOS 27 kernelcache: same arguments (KC KERNEL OUTPUT --keep ... --native ...), with kc27's layout.
+
+The top-level segment starts come from k27/segaddrs.json (k27/kc27-layout.py, the layout the kernel was linked with).
+"""
+import importlib.util
+import json
+import os
+import sys
+from pathlib import Path
+
+HERE = Path(__file__).resolve().parent
+spec = importlib.util.spec_from_file_location('kc_build', HERE.parent / 'scripts/kc-build.py')
+source = spec.loader.get_data(spec.origin).decode()
+source = source[:source.rindex('\nmain()')]          # the module without its trailing main() call
+module = importlib.util.module_from_spec(spec)
+sys.modules['kc_build'] = module
+sys.path.insert(0, str(HERE.parent / 'scripts'))
+exec(compile(source, spec.origin, 'exec'), module.__dict__)
+
+layout = json.loads((HERE / 'segaddrs.json').read_text())
+module.DATA_CONST_START = layout['DATA_CONST_START']
+module.DATA_START = layout['DATA_START']
+# No kept kext's bytes are patched: Sandbox's Data volume prefix (/System/Volumes/Data) was rewritten to /private/var/.data until
+# the root's writable entries became real firmlinks (kern_exec.c native_owner_firmlinks_prepare).
+# AMFI's only reference to PAGE_SHIFT_CONST (its GOT slot, used by CoreEntitlements' CEElementIterate alone) goes to the kernel's
+# k27_amfi_page_shift (31): that check fails when sp is within 0x80 of a page start, a fixed outcome on a fixed call chain over page
+# aligned kernel stacks, and with our kernel's frames every spawn's entitlement dictionary copy failed ("failed to create OSDictionary
+# copy: 14" panic). The kext's bytes stay as shipped.
+# The slot is the second of AMFI's __DATA_CONST,__got in the 27.2 vma2 kernelcache (0xfffffe0007b439c8 in 27.0.1's).
+module.KEPT_POINTER_REBINDS = [(0xfffffe0007b439c8, '_k27_amfi_page_shift')]
+
+# Symbols of the native kexts as linked (for k27/sym.py), next to the output: OUTPUT.natives.json {symbol: address}.
+natives = {}
+link = module.kc_native.link
+
+
+def recording_link(*args, **kwargs):
+    linked = link(*args, **kwargs)
+    natives.update(linked['symbols'])
+    return linked
+
+
+module.kc_native.link = recording_link
+module.main()
+output = Path([a for a in sys.argv[1:] if not a.startswith('-')][2])
+output.with_suffix('.natives.json').write_text(json.dumps(natives))
