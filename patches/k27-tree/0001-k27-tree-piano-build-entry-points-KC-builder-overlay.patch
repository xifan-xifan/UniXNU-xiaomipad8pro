diff --git a/overlay-piano/DroidVMEthernetReserved.cpp b/overlay-piano/DroidVMEthernetReserved.cpp
new file mode 100644
index 0000000..d569fdf
--- /dev/null
+++ b/overlay-piano/DroidVMEthernetReserved.cpp
@@ -0,0 +1,9 @@
+// piano: macOS 27.0.1's IONetworkingFamily (26A434 vma2 kernelcache) exports no symbols for IONetworkController's unused
+// reserved slots 2-5 (identical bodies folded into the later ones); the 27.2 SDK header still declares them, so DroidVMEthernet's
+// vtable names them. They are never called: like Apple's, these just panic.
+#include <IOKit/network/IONetworkController.h>
+#include <kern/debug.h>
+void IONetworkController::_RESERVEDIONetworkController2() { panic("IONetworkController reserved slot 2"); }
+void IONetworkController::_RESERVEDIONetworkController3() { panic("IONetworkController reserved slot 3"); }
+void IONetworkController::_RESERVEDIONetworkController4() { panic("IONetworkController reserved slot 4"); }
+void IONetworkController::_RESERVEDIONetworkController5() { panic("IONetworkController reserved slot 5"); }
diff --git a/overlay-piano/display-wc.py b/overlay-piano/display-wc.py
new file mode 100644
index 0000000..9e2ef2f
--- /dev/null
+++ b/overlay-piano/display-wc.py
@@ -0,0 +1,23 @@
+#!/usr/bin/env python3
+"""piano: vgpu-wc=1 maps a guest blob's own pages write-combined in its client (DroidVMVirtioGpu3D.cpp mapResource).
+
+DroidVM's drm2kgsl host imports guest pages IO-coherent (KGSL), so the guest maps them write-back. The piano's host is msm DRM,
+whose dma-buf imports are always MSM_BO_WC (msm_gem_import): the GPU's pagetables map them without IOMMU_CACHE and the GPU does
+not snoop the CPU's caches. The guest's mapping must not cache them either. The pool (the context's shmem, CPU only on both sides)
+and a caller's own pages (CREATE_BLOB_USER) stay write-back."""
+import sys
+from pathlib import Path
+
+p = Path(sys.argv[1])
+s = p.read_text()
+old = '''        r->map = memory->createMappingInTask(task, 0, IOOptionBits(kIOMapAnywhere) | IOOptionBits(kIOMapCopybackCache));'''
+new = '''        // piano: vgpu-wc=1, write-combined guest pages for a host whose GPU imports them non-coherent (msm DRM)
+        static int wc = -1;
+        if (wc < 0) { unsigned on = 0; PE_parse_boot_argn("vgpu-wc", &on, sizeof on); wc = on != 0; }
+        const IOOptionBits cache = (wc && !r->hostVisible && !r->wired) ? IOOptionBits(kIOMapWriteCombineCache)
+                                                                         : IOOptionBits(kIOMapCopybackCache);
+        r->map = memory->createMappingInTask(task, 0, IOOptionBits(kIOMapAnywhere) | cache);'''
