diff --git a/build-k27-piano.sh b/build-k27-piano.sh
new file mode 100755
index 0000000..a623f39
--- /dev/null
+++ b/build-k27-piano.sh
@@ -0,0 +1,56 @@
+#!/bin/bash
+# k27 macOS 内核（xnu-12377 + patches/xnu-12377 0001-0049）的本机重建构建脚本。
+# 作者的 out/x12377/build-kernel.sh 未公开；这里按 k27/build-kernel27.sh 传给它的参数、UniXNU 的 XNU make 调用重写。
+# 底座：Droid-VM/UniXNU wip/droidvm 的 ipados27 板 bootstrap 出来的 xnu-12377 arm64e 环境（fakeroot、firehose、ArmDTPlatform/ArmCpu）。
+#   build-k27-piano.sh [make target...]      环境：JOBS（默认 10）SEGADDRS=0（不用 KC 段地址，先链一个普通内核量尺寸）
+set -euo pipefail
+export DEVELOPER_DIR=/Applications/Xcode.app/Contents/Developer
+# k27 的 iokit/DriverKit/Makefile 用了 GNU 风格的 sed -i（作者在 Linux 上构建）
+export PATH=/opt/homebrew/opt/gnu-sed/libexec/gnubin:/opt/homebrew/opt/llvm/bin:/opt/homebrew/bin:$PATH
+M=$(cd "$(dirname "$0")" && pwd)
+B=$(dirname "$M")
+UP=$B/UniXNU-up/out/droidvm/ipados-27.0.1-24A446/droidvm_ipados27/tree
+T=$M/out/k27/xnu
+X=$M/out/x12377
+O=$X/build/xnu
+FR=$X/fakeroot
+# KDK 去掉 Tightbeam：它的 libTightbeam.a 是 macOS 平台的，iOS 平台链接（ld-classic）拒收；exclaves 在这台 VM 上不存在
+KDKROOT=$M/out/k27/kdk-notb
+mkdir -p $O $X
+# fakeroot：沿用 12377 底座（libplatform/libdispatch 头、availability.pl、arm64e firehose），再用 k27 源码重装内核头
+if [ ! -d $FR ]; then cp -R $UP/.cache/fakeroot $FR; fi
+export KERNEL_SDKROOT=$FR
+export XNU_AVAILABILITY_PL=$FR/usr/local/libexec/availability.pl
+if [ ! -f $FR/.k27-headers ]; then
+  make -C $T installhdrs SDKROOT=macosx ARCH_CONFIGS=ARM64 MACHINE_CONFIGS=BCM2837 KERNEL_CONFIGS=DEVELOPMENT \
+    RC_DARWIN_KERNEL_VERSION=27.0.0 RC_ProjectSourceVersion=12377.121.6 MAKEJOBS=-j${JOBS:-10} \
+    OBJROOT=$O/k27-hdr-obj SYMROOT=$O/k27-hdr-sym DSTROOT=$FR KDKROOT=$KDKROOT > $X/installhdrs.log 2>&1
+  touch $FR/.k27-headers
+fi
+# ArmDTPlatform/ArmCpu 必须按 k27（macOS 目标：kext vtable 布局带 padding）的编译记录重编，否则 PAC 校验失败（见 2026-11-09 第一次启动的 panic）
+DT=$X/un/build/platform-12377-arm64e/ArmDTPlatform/libArmDTPlatform.a
+CPU=$X/un/build/platform-12377-arm64e/ArmCpu/libArmCpu.a
+FH=$FR/usr/local/lib/kernel
+# Xcode 27 的 ld（ld-prime）不再支持 -threaded_starts_section：内核用 CLT 的 ld-classic（ld64-957）链接
+LDX="-B$X/ldc -Wl,-no_fixup_chains -Wl,-threaded_starts_section"
+LD_ARCHIVES="$LDX -L$FH -lfirehose_kernel -Wl,-force_load,$DT -Wl,-force_load,$CPU ${K27_EXTRA_LD:-}"
+OWNER="-DXNU_NATIVE_RAM_BLOCK=1 -DXNU_OWNER_DATA_MOUNT=1 -DXNU_OWNER_CACHE_MOUNT=1 -DXNU_OWNER_UNION_SYSTEMOS=1 -DXNU_OWNER_BOOT_MANIFEST=1 -DXNU_OWNER_CACHE_STARTUP=1"
+WNO="-Wno-reserved-identifier -Wno-pre-c11-compat -Wno-missing-designated-field-initializers -Wno-suggest-override -Wno-unnecessary-virtual-specifier -Wno-suggest-destructor-override -Wno-ms-bitfield-padding"
+EXTRA_CFLAGS="$WNO -DXNU_VM_GUEST=1 -DXNU_NATIVE_CS_HASH_CACHE=1 $OWNER -DXNU_ARM_DT_PLATFORM=1 -DXNU_ARMCPU=1 -DXNU_NATIVE_PAN=1 -DXNU_SOURCE_CORECRYPTO14=0 -DXNU_NATIVE_TRUST_CACHE=1 ${XNU_EXTRA_CFLAGS:-}"
+export CCC_OVERRIDE_OPTIONS='+-Wno-error=missing-designated-field-initializers'
+SEG=()
+if [ "${SEGADDRS:-1}" = 1 ]; then SEG=("XNU_KC_SEGADDRS=$(bash $M/k27/segaddrs.sh)"); fi
+make -C $T "${@:-build}" SDKROOT=iphoneos ARCH_CONFIGS=ARM64 MACHINE_CONFIGS=BCM2837 KERNEL_CONFIGS=DEVELOPMENT \
+  ARCH_STRING_FOR_CURRENT_MACHINE_CONFIG=arm64e LARGE_MEMORY_DEFINE=-UARM_LARGE_MEMORY \
+  ARM64_LINK_ADDR=0xfffffff007004000 ARM64_PLKSEG_ADDR=0xfffffff004004000 \
+  DEPLOYMENT_TARGET_FLAGS="-miphoneos-version-min=26.0 -DXNU_TARGET_OS_OSX" \
+  DEPLOYMENT_LINKER_FLAGS="-Wl,-ios_version_min,26.0" \
+  RC_DARWIN_KERNEL_VERSION=27.0.0 RC_ProjectSourceVersion=12377.121.6 \
+  BUILD_LTO=0 BOUND_CHECKS=0 BUILD_WERROR=0 MAKEJOBS=-j${JOBS:-10} \
+  KDKROOT=$KDKROOT CFLAGS_EXTRA="$EXTRA_CFLAGS" \
+  LD_KERNEL_ARCHIVES="$LD_ARCHIVES" XNU_EXTERNAL_KERNEL_ARCHIVES="$DT $CPU" \
+  "pe_init.o_CFLAGS_ADD=-DXNU_DT_PANIC_REGION=1" "start.o_SFLAGS_ADD=-DXNU_NATIVE_ARCH_TIMER=1" \
+  "copyio.o_CFLAGS_ADD=-march=armv8.1-a" "pcb.o_CFLAGS_ADD=-march=armv8.1-a" "platform_tests.o_CFLAGS_ADD=-march=armv8.1-a" \
+  ${SEG[@]+"${SEG[@]}"} \
+  OBJROOT=$O/k27-obj SYMROOT=$O/k27-sym DSTROOT=$O/k27-dst
+ls -la $O/k27-obj/DEVELOPMENT_ARM64_BCM2837/mach.development.bcm2837.unstripped* 2>/dev/null
diff --git a/build-metal-plugin-piano.sh b/build-metal-plugin-piano.sh
new file mode 100755
index 0000000..6b76701
--- /dev/null
+++ b/build-metal-plugin-piano.sh
@@ -0,0 +1,31 @@
+#!/bin/bash
+# macOS 版 Metal 插件 NativeAdrenoMetal.bundle（Mac 原生 Xcode 构建）：overlay/metal/NativeAdrenoMetalPlugin.mm + NativeMetal fb063de 的前端
+# （build-metal-plugin.sh 的改动）+ Linux 构建机交叉编好的 bridge（libnative_metal_bridge.a）+ 本机编的 Turnip。
+set -euo pipefail
+export DEVELOPER_DIR=/Applications/Xcode.app/Contents/Developer
+M=$(cd "$(dirname "$0")" && pwd); T=$(dirname "$M")/UniXNU-turnip
+U=$T/drivers/AdrenoMetal; O=$M/out/metal/plugin; B=$O/NativeAdrenoMetal.bundle/Contents
+SDK=$(xcrun --sdk macosx --show-sdk-path)
+rm -rf $O/NativeAdrenoMetal.bundle; mkdir -p "$B/MacOS"
+CXX=(xcrun clang++ -target arm64e-apple-macos14.0 -isysroot $SDK -fobjc-arc -O2 -std=c++17 -Wno-deprecated-declarations -c -x objective-c++ -I $U)
+"${CXX[@]}" $M/overlay/metal/NativeAdrenoMetalPlugin.mm -o $O/plugin.o
+python3 $M/scripts/piano-frontend-patch.py $U/NativeBridgeMetalFrontend.mm $O/frontend.mm
+"${CXX[@]}" $O/frontend.mm -o $O/frontend.o
+xcrun ld -arch arm64e -platform_version macos 14.0 27.2 -syslibroot $SDK -F $M/overlay/metal/frameworks \
+  -bundle -dead_strip -o $B/MacOS/NativeAdrenoMetal $O/plugin.o $O/frontend.o $M/out/metal/bridge/libnative_metal_bridge.a \
+  -framework Foundation -framework Metal -framework IOSurface -framework IOKit -framework CoreFoundation -framework IOGPU \
+  -lobjc -lc++ -lSystem -liconv 2>&1 | { grep -v "was built for newer" || true; }
+cp $T/build/mesa-tu-macos/src/freedreno/vulkan/libvulkan_freedreno.dylib $B/MacOS/
+# macho-weak-self-binds.py (chained fixups) rewrites binds after the linker signed the image and leaves its page hashes stale:
+# XNU rejected the changed page in WindowServer ("rejecting invalid page ... offset 0xf2c000"). Sign it again (ad hoc).
+codesign -f -s - $B/MacOS/libvulkan_freedreno.dylib
+codesign -v $B/MacOS/libvulkan_freedreno.dylib
+python3 - "$B/Info.plist" <<'EOF'
+import plistlib, sys
+open(sys.argv[1], 'wb').write(plistlib.dumps(dict(
+    CFBundleIdentifier='org.droidvm.NativeAdrenoMetal', CFBundleExecutable='NativeAdrenoMetal', CFBundlePackageType='BNDL',
+    CFBundleVersion='1', CFBundleShortVersionString='1', NSPrincipalClass='NativeAdrenoMetalDevice',
+    CFBundleSupportedPlatforms=['MacOSX'], LSMinimumSystemVersion='14.0'), fmt=plistlib.FMT_XML))
+EOF
+codesign -dv $B/MacOS/NativeAdrenoMetal 2>&1 | grep -E "Signature|flags" | head -2
+ls -la $B/MacOS
