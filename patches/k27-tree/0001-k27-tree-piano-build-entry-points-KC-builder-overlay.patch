diff --git a/patches/xnu-12377/0050-vm-guest-tlb.patch b/patches/xnu-12377/0050-vm-guest-tlb.patch
new file mode 100644
index 0000000..31278b6
--- /dev/null
+++ b/patches/xnu-12377/0050-vm-guest-tlb.patch
@@ -0,0 +1,79 @@
+From 7354e15d5c8f027fee43a69031c0e7dbb8e63ca5 Mon Sep 17 00:00:00 2001
+From: leozhang <zwj8727@gmail.com>
+Date: Mon, 9 Nov 2026 21:06:04 +0800
+Subject: [PATCH] k27: VM-guest TLB safety: 16-bit ASIDs and non-global
+ shared-region mappings (XNU_VM_GUEST_TLB)
+
+Gunyah does not flush a CPU's TLB when another vCPU of the VM runs there. With 8-bit ASIDs
+XNU multiplexes address spaces onto one ASID and keeps them apart with per-CPU bookkeeping
+and core-local flushes; after a vCPU migration processes read each other's pages (launchd
+exited reading sort's _pthread_count). Shared-region mappings were global and also only
+flushed core-locally. BCM2837.h now defines XNU_VM_GUEST_TLB (default 1): HAS_16BIT_ASID
+(unique ASID per address space, broadcast-flushed before reuse) and nG shared-region PTEs.
+asidtest with forced migrations: 0 cross-address-space reads (8-bit kernel: several in 45 s).
+
+Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
+---
+ osfmk/arm/pmap/pmap.c           |  6 ++++++
+ osfmk/arm64/cpu.c               |  2 ++
+ pexpert/pexpert/arm64/BCM2837.h | 12 ++++++++++++
+ 3 files changed, 20 insertions(+)
+
+diff --git a/osfmk/arm/pmap/pmap.c b/osfmk/arm/pmap/pmap.c
+index 79d0bc1..609b521 100644
+--- a/osfmk/arm/pmap/pmap.c
++++ b/osfmk/arm/pmap/pmap.c
+@@ -6162,6 +6162,12 @@ pmap_construct_pte(
+ 	} else {
+ 		if (pmap->type != PMAP_TYPE_NESTED) {
+ 			pte |= ARM_PTE_NG;
++#if XNU_VM_GUEST_TLB
++		} else if (true) {
++			/* Shared-region entries tagged with the ASID of the address space that walked them (BCM2837.h): a global one
++			 * outlives the core-local flush pmap_switch() gives it on a vCPU that has moved to another physical CPU. */
++			pte |= ARM_PTE_NG;
++#endif
+ 		} else if ((pmap->nested_region_unnested_table_bitmap)
+ 		    && (va >= pmap->nested_region_addr)
+ 		    && (va < (pmap->nested_region_addr + pmap->nested_region_size))) {
+diff --git a/osfmk/arm64/cpu.c b/osfmk/arm64/cpu.c
+index d10d7a1..04ecbbc 100644
+--- a/osfmk/arm64/cpu.c
++++ b/osfmk/arm64/cpu.c
+@@ -882,8 +882,10 @@ cpu_data_init(cpu_data_t *cpu_data_ptr)
+ 	pmap_cpu_data_ptr->pv_free_spill_marker = NULL;
+ #if !CONFIG_SPTM
+ 	pmap_cpu_data_ptr->cpu_nested_pmap = (struct pmap *) NULL;
++#if !HAS_16BIT_ASID   /* XNU_VM_GUEST_TLB (BCM2837.h): no per-CPU alias bookkeeping with 16-bit ASIDs */
+ 	bzero(&(pmap_cpu_data_ptr->cpu_sw_asids[0]), sizeof(pmap_cpu_data_ptr->cpu_sw_asids));
+ #endif
++#endif
+ #endif /* !XNU_MONITOR */
+ 	cpu_data_ptr->halt_status = CPU_NOT_HALTED;
+ #if __ARM_KERNEL_PROTECT__
+diff --git a/pexpert/pexpert/arm64/BCM2837.h b/pexpert/pexpert/arm64/BCM2837.h
+index 0d7e976..e6e180a 100644
+--- a/pexpert/pexpert/arm64/BCM2837.h
++++ b/pexpert/pexpert/arm64/BCM2837.h
+@@ -15,6 +15,18 @@
+ #define HAS_APPLE_PAC 1
+ #endif
+ #define BCM2837_BRINGUP
++
++/* XNU_VM_GUEST_TLB (k27/build-kernel27.sh): a guest of a hypervisor that does not flush a CPU's TLB when another vCPU of the VM
++ * comes to run there (Gunyah on the piano: the vCPUs are host threads the host migrates). No correctness may rest on core-local
++ * TLB invalidation then: 16-bit ASIDs, one per address space and broadcast-flushed before reuse (with 8-bit ones address spaces
++ * share an ASID, told apart by per-CPU bookkeeping and core-local flushes: processes read each other's pages after a migration),
++ * and non-global shared-region mappings (pmap.c), whose global entries were also only flushed core-locally. */
++#ifndef XNU_VM_GUEST_TLB
++#define XNU_VM_GUEST_TLB 1   /* the piano's k27 is only ever such a guest; here, so assembly (TCR_EL1.AS) agrees with C */
++#endif
++#if XNU_VM_GUEST_TLB
++#define HAS_16BIT_ASID 1
++#endif
+ #define ARM_ARCH_TIMER
+ 
+ #define __ARM_ARCH__              8
+-- 
+2.55.0
+
diff --git a/patches/xnu-12377/0051-vm-guest-poweroff-unmount-bootstrap-tables.patch b/patches/xnu-12377/0051-vm-guest-poweroff-unmount-bootstrap-tables.patch
new file mode 100644
index 0000000..a8d0f48
--- /dev/null
+++ b/patches/xnu-12377/0051-vm-guest-poweroff-unmount-bootstrap-tables.patch
@@ -0,0 +1,99 @@
+From f0d10c6165be3ded1acf3945c38506414065f139 Mon Sep 17 00:00:00 2001
+From: leozhang <zwj8727@gmail.com>
+Date: Tue, 10 Nov 2026 00:53:22 +0800
+Subject: [PATCH] k27: VM guest: PSCI power-off at halt, dead union parents at
+ the final unmount, bootstrap tables for >6 GiB
+
+- halt_all_cpus ends with PSCI SYSTEM_OFF/SYSTEM_RESET over HVC (crosvm's /psci method): Gunyah ends the VM and crosvm exits
+  (XNU_VM_GUEST, set by build-k27-piano.sh).
+- vnode_rele_internal: a VBAD vnode released past zero is a union parent across mounts (SystemOS over /) reclaimed by the halt's
+  forced unmount; restore the count instead of panicking (counted in vnode_rele_dead_past_zero).
+- BOOTSTRAP_TABLE_SIZE for native 4 KiB: 48 pages (2 + 2*(GiB+1), up to 22 GiB); 16 overran start.s's area above 6 GiB.
+
+Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
+---
+ bsd/vfs/vfs_subr.c             | 18 ++++++++++++++++++
+ osfmk/arm/pmap/pmap.h          |  7 ++++---
+ osfmk/arm64/machine_routines.c | 11 +++++++++++
+ 3 files changed, 33 insertions(+), 3 deletions(-)
+
+diff --git a/bsd/vfs/vfs_subr.c b/bsd/vfs/vfs_subr.c
+index 456b500..282c705 100644
+--- a/bsd/vfs/vfs_subr.c
++++ b/bsd/vfs/vfs_subr.c
+@@ -2661,6 +2661,10 @@ vnode_rele_ext(vnode_t vp, int fmode, int dont_reenter)
+ }
+ 
+ 
++#if XNU_VM_GUEST
++uint32_t vnode_rele_dead_past_zero;
++#endif
++
+ void
+ vnode_rele_internal(vnode_t vp, int fmode, int dont_reenter, int locked)
+ {
+@@ -2677,6 +2681,20 @@ vnode_rele_internal(vnode_t vp, int fmode, int dont_reenter, int locked)
+ #endif
+ 	/* Enable atomic ops on v_usecount without the vnode lock */
+ 	old_usecount = os_atomic_dec_orig(&vp->v_usecount, relaxed);
++#if XNU_VM_GUEST
++	if (old_usecount < 1 && vp->v_type == VBAD) {
++		/*
++		 * A reclaimed vnode a child still names as its parent across mounts: the union of the SystemOS
++		 * volume over / (patches 0015/0023/0024) gives vnodes of / parents on the SystemOS mount, which
++		 * the halt's forced unmount reclaims first, dropping its references; reclaiming the child then
++		 * releases the parent once more (vnode_update_identity). Nothing holds the dead vnode: put the
++		 * count back and carry on rather than panic in the middle of the shutdown.
++		 */
++		os_atomic_inc(&vp->v_usecount, relaxed);
++		os_atomic_inc(&vnode_rele_dead_past_zero, relaxed);   /* for the host rig (gpeek) */
++		goto done;
++	}
++#endif
+ 	if (old_usecount < 1) {
+ 		/*
+ 		 * Because we allow atomic ops on usecount (in lookup only, under
+diff --git a/osfmk/arm/pmap/pmap.h b/osfmk/arm/pmap/pmap.h
+index b236ca6..ab1de89 100644
+--- a/osfmk/arm/pmap/pmap.h
++++ b/osfmk/arm/pmap/pmap.h
+@@ -116,10 +116,11 @@
+  */
+ #define BOOTSTRAP_TABLE_SIZE (ARM_PGBYTES * 34)
+ #elif !defined(APPLE_ARM64_ARCH_FAMILY) && !__ARM_16K_PG__
+-/* Native 4 KiB: two roots plus up to seven L2 pages per 6 GiB mapping.
+- * The physical and virtual bases may each straddle an extra 1 GiB region.
++/* Native 4 KiB: two roots plus, for each of the two bootstrap mappings (V=P and KVA), one L2 page per GiB of DRAM
++ * and one more where the base straddles a 1 GiB region: 2 + 2 * (GiB + 1). 16 pages covered 6 GiB: a 7 GiB guest
++ * overran the area in start.s and died before its first message (the piano, 2026-11-10). 48 cover 22 GiB (192 KiB).
+  */
+-#define BOOTSTRAP_TABLE_SIZE (ARM_PGBYTES * 16)
++#define BOOTSTRAP_TABLE_SIZE (ARM_PGBYTES * 48)
+ #else /* defined(ARM_LARGE_MEMORY) */
+ #define BOOTSTRAP_TABLE_SIZE (ARM_PGBYTES * 8)
+ #endif /* defined(ARM_LARGE_MEMORY) */
+diff --git a/osfmk/arm64/machine_routines.c b/osfmk/arm64/machine_routines.c
+index f456377..2b62e95 100644
+--- a/osfmk/arm64/machine_routines.c
++++ b/osfmk/arm64/machine_routines.c
+@@ -934,6 +934,17 @@ halt_all_cpus(boolean_t reboot)
+ 		printf("CPU halted\n");
+ 		PEHaltRestart(kPEHaltCPU);
+ 	}
++#if XNU_VM_GUEST
++	/*
++	 * A VM guest ends here: PSCI SYSTEM_RESET or SYSTEM_OFF through the conduit crosvm's FDT names (/psci method "hvc"),
++	 * so the hypervisor ends the VM and crosvm exits (or restarts it), where the platform expert has no power-off of its
++	 * own and its reset went through SMC, which Gunyah does not route to PSCI.
++	 */
++	{
++		register uint64_t x0 __asm__("x0") = reboot ? 0x84000009ULL : 0x84000008ULL;
++		__asm__ volatile ("hvc #0" : "+r"(x0) : : "x1", "x2", "x3", "memory");
++	}
++#endif
+ 	while (1) {
+ 		;
+ 	}
+-- 
+2.55.0
+
diff --git a/patches/xnu-12377/0052-vm-guest-zone-va-12g.patch b/patches/xnu-12377/0052-vm-guest-zone-va-12g.patch
new file mode 100644
index 0000000..8e4145d
--- /dev/null
+++ b/patches/xnu-12377/0052-vm-guest-zone-va-12g.patch
@@ -0,0 +1,39 @@
+From a7e76ffcb80c34acc2c689e46fa8ff8946ffe5c4 Mon Sep 17 00:00:00 2001
+From: leozhang <zwj8727@gmail.com>
+Date: Tue, 10 Nov 2026 03:16:42 +0800
+Subject: [PATCH] k27: VM guest: 12 GiB of zone VA instead of 24 (guest RAM
+ past 8 GiB)
+
+The kernel map shares its VA window with the physical aperture, which grows with the guest's RAM.
+With 24 GiB reserved for zones the pointer ranges were ~640 MiB each at 8 GiB of RAM and negative at
+10 GiB (kmem_add_extra_claims: free_size - claims underflowed, the kernel stopped in startup). The zone
+map is at most 8 GiB (~3/8 of RAM below that). 10, 12 and 13 GiB guests boot and log in.
+
+Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
+---
+ osfmk/kern/zalloc.c | 9 +++++++++
+ 1 file changed, 9 insertions(+)
+
+diff --git a/osfmk/kern/zalloc.c b/osfmk/kern/zalloc.c
+index 9edf8c5..c831172 100644
+--- a/osfmk/kern/zalloc.c
++++ b/osfmk/kern/zalloc.c
+@@ -170,6 +170,15 @@ ZONE_DEFINE_TYPE(percpu_u64_zone, "percpu.64", uint64_t,
+ #if   XNU_PLATFORM_MacOSX
+ #define ZONE_MAP_MAX            (32ULL << 30)
+ #define ZONE_MAP_VA_SIZE        (128ULL << 30)
++#elif XNU_VM_GUEST
++/*
++ * VM guest (4 KiB pages, no ARM_LARGE_MEMORY): the kernel map shares its VA window with the physical
++ * aperture, which grows with the guest's RAM. With 24 GiB reserved for zones the pointer ranges were
++ * ~640 MiB each at 8 GiB of RAM and negative at 10 GiB (kmem_add_extra_claims). The zone map itself
++ * is at most ZONE_MAP_MAX (and ~3/8 of RAM below that), so 12 GiB of VA is plenty.
++ */
++#define ZONE_MAP_MAX            (8ULL << 30)
++#define ZONE_MAP_VA_SIZE        (12ULL << 30)
+ #else
+ #define ZONE_MAP_MAX            (8ULL << 30)
+ #define ZONE_MAP_VA_SIZE        (24ULL << 30)
+-- 
+2.55.0
+
diff --git a/scripts/piano-frontend-patch.py b/scripts/piano-frontend-patch.py
new file mode 100644
index 0000000..cfe076c
--- /dev/null
+++ b/scripts/piano-frontend-patch.py
@@ -0,0 +1,81 @@
+#!/usr/bin/env python3
+# piano: the frontend edits of build-metal-plugin.sh, as a file; an edit whose anchor this NativeMetal (fb063de) lacks is skipped
+import sys
+s = open(sys.argv[1]).read()
+for old, new in [
+    (' NBHeap *heap=[NBHeap new];heap.handle=handle;',
+     ' NBLOG(@"native-metal: heap %lu bytes type %ld options %lx -> %llu",(unsigned long)d.size,(long)d.type,(unsigned long)d.resourceOptions,'
+     'nmb_heap_size(handle));\n NBHeap *heap=[NBHeap new];heap.handle=handle;'),
+    # The encoding thread (NativeMetal fd9fbe1: the runtime's half of each encoder call on a thread of its own, fed in batches) in
+    # WindowServer as in backboardd, the render server it was made for; /private/var/ngpu/debug/no-encode-thread turns it off.
+    ('                                (isRenderServer() || access("/private/var/ngpu/debug/encode-thread",F_OK)==0);',
+     '                                (isRenderServer() || !strcmp(getprogname(),"WindowServer") ||\n'
+     '                                 access("/private/var/ngpu/debug/encode-thread",F_OK)==0);'),
+    # The runtime converts a two-plane YCbCr texture on the CPU at every encoder that uses it (planes copied to staging, then a
+    # dispatch): WindowServer's 4096x2160 wallpaper frames (YCBCR8_444_2P) took the 4 GiB guest into jetsam. Above 1 Mpx it is
+    # refused here; the server has no other way to draw the wallpaper (refused, the desktop is never repainted where windows moved
+    # off it), so the 8-bit formats are converted once per surface contents before this (the frontend's convertedYCbCrTexture) and
+    # only the others still reach this refusal; the small backdrop samples (512x512) are made.
+    # Where the runtime reads 4:2:0 planes in place (METAL2VULKAN_YCBCR_PLANES_ONLY, set for WindowServer by the plugin; patches/
+    # metal2vulkan-macos/0001), YCBCR8_420_2P and YCBCR10_420_2P (500, 505) over plane 0 go to it: neither converted on the CPU nor refused.
+    (' if(id<MTLTexture> converted=convertedYCbCrTexture(self,d,surface,plane))return converted;\n',
+     ' static const bool planesInPlace=getenv("METAL2VULKAN_YCBCR_PLANES_ONLY")!=nullptr;\n'
+     ' const bool inPlace=planesInPlace && plane==0 && (d.pixelFormat==500 || d.pixelFormat==505);\n'
+     ' if(inPlace){static std::atomic<unsigned> made;if(made++<4)NBLOG(@"native-metal: surface texture %lux%lu YCbCr format %lu read in place",'
+     '(unsigned long)d.width,(unsigned long)d.height,(unsigned long)d.pixelFormat);}\n'
+     ' if(id<MTLTexture> converted=inPlace?nil:convertedYCbCrTexture(self,d,surface,plane))return converted;\n'),
+    # Such a texture reads the video frame's own pages when the GPU runs a pass that samples it (no copy), so its surface is counted in
+    # use from the commit of each command buffer that binds it until that command buffer completes: a decoder's pool reuses a surface no
+    # one uses, and wrote the next frame into one a lock-screen pass was still reading (black bands a CTU row high). Counted for the
+    # texture's life instead, every pool surface stayed in use (WindowServer keeps a texture of each), and the decoder, out of
+    # surfaces, showed grey frames but for what moved.
+    ('@property(nonatomic,strong) NSMutableSet *surfaces;',
+     '@property(nonatomic,strong) NSMutableSet *surfaces;\n@property(nonatomic,strong) NSMutableArray *surfacesInUse;'),
+    ('  flushSurfaces(_surfaces);\n  if(gLogTextures)dumpSurfacesOnce(_surfaces,_resourceOwners);\n',
+     '  flushSurfaces(_surfaces);\n'
+     '  if(getenv("METAL2VULKAN_YCBCR_PLANES_ONLY"))for(NBTexture *texture in _surfaces)\n'
+     '   if(texture.surface && (texture.descriptor.format==500 || texture.descriptor.format==505)) {\n'
+     '    if(!_surfacesInUse)_surfacesInUse=[NSMutableArray array];\n'
+     '    IOSurfaceIncrementUseCount(texture.surface);[_surfacesInUse addObject:texture];\n'
+     '   }\n'
+     '  if(gLogTextures)dumpSurfacesOnce(_surfaces,_resourceOwners);\n'),
+    (' [_surfaces removeAllObjects];[_writtenSurfaces removeAllObjects];[_resourceOwners removeAllObjects];\n',
+     ' for(NBTexture *texture in _surfacesInUse)IOSurfaceDecrementUseCount(texture.surface);\n _surfacesInUse=nil;\n'
+     ' [_surfaces removeAllObjects];[_writtenSurfaces removeAllObjects];[_resourceOwners removeAllObjects];\n'),
+    (' NmbTextureDescriptor descriptor;if(!buffer || !textureDescriptor(d,&descriptor))return nil;\n const uint64_t base=(uintptr_t)IOSurfaceGetBaseAddress(surface),',
+     ' NmbTextureDescriptor descriptor;if(!buffer || !textureDescriptor(d,&descriptor))return nil;\n'
+     ' if(d.pixelFormat>=500 && d.pixelFormat<600 && (uint64_t)d.width*d.height>1024*1024 &&\n'
+     '    !(getenv("METAL2VULKAN_YCBCR_PLANES_ONLY") && plane==0 && (d.pixelFormat==500 || d.pixelFormat==505))){\n'
+     '  static std::atomic<unsigned> refusals;   // the server asks again at every frame\n'
+     '  if(refusals++<4)NBLOG(@"native-metal: surface texture refused: %lux%lu YCbCr format %lu converts on the CPU",(unsigned long)d.width,'
+     '(unsigned long)d.height,(unsigned long)d.pixelFormat);\n'
+     '  return nil;}\n'
+     ' const uint64_t base=(uintptr_t)IOSurfaceGetBaseAddress(surface),'),
+]:
+    if s.count(old) != 1:
+        print('piano: frontend edit skipped (not in this NativeMetal):', old.strip().splitlines()[0][:90], file=sys.stderr)
+        continue
+    s = s.replace(old, new)
+# NMB_FRAME_ROWS=1 (diagnostics, research/debug-2026-10-27): WindowServer's telemetry table every 20 s without NATIVE_METAL_TIMING in
+# its launchd job, and each K row (a commit) with its GPU time (GPUEndTime - GPUStartTime) and its encoding (command buffer made to commit).
+import os
+if os.environ.get('NMB_FRAME_ROWS') == '1':
+    for old, new in [
+        (' if(!getenv("NATIVE_METAL_TIMING"))return;\n',
+         ' if(!getenv("NATIVE_METAL_TIMING") && strcmp(getprogname(),"WindowServer"))return;\n'),
+        ('struct CommitRecord {uint64_t committedUs=0,callbackUs=0,ageUs=0;',
+         'struct CommitRecord {uint64_t committedUs=0,callbackUs=0,ageUs=0,gpuUs=0;'),
+        (' {\n  const uint64_t took=nowUs()-commandBuffer.committedUs;\n',
+         ' {\n  const uint64_t took=nowUs()-commandBuffer.committedUs;\n'
+         '  const double gpuSeconds=[commandBuffer GPUEndTime]-[commandBuffer GPUStartTime];\n'),
+        ('  if(r.index==commandBuffer.commitIndex) {\n   r.callbackUs=took;\n',
+         '  if(r.index==commandBuffer.commitIndex) {\n   r.callbackUs=took;r.gpuUs=gpuSeconds>0?(uint64_t)(gpuSeconds*1e6):0;\n'),
+        ('   row("K%u t=%llu.%03llus rp%u dr%u kpx%llu cs%u bl%u ctc=%lluus",',
+         '   row("K%u t=%llu.%03llus rp%u dr%u kpx%llu cs%u bl%u ctc=%lluus gpu=%lluus enc=%lluus",'),
+        ('(unsigned long long)(r.work.pixels>>10),r.work.dispatches,r.work.blits,(unsigned long long)r.callbackUs);',
+         '(unsigned long long)(r.work.pixels>>10),r.work.dispatches,r.work.blits,(unsigned long long)r.callbackUs,(unsigned long long)r.gpuUs,'
+         '(unsigned long long)r.ageUs);'),
+    ]:
+        assert s.count(old) == 1, old
+        s = s.replace(old, new)
+open(sys.argv[2], 'w').write(s)
