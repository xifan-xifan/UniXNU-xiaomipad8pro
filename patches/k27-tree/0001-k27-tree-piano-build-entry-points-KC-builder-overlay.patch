diff --git a/overlay-piano/gpu-check.mm b/overlay-piano/gpu-check.mm
new file mode 100644
index 0000000..370c4d6
--- /dev/null
+++ b/overlay-piano/gpu-check.mm
@@ -0,0 +1,135 @@
+// piano: gpu-check, a launchd job of the Data seed (stage-gpu-plugin.py --probe) that checks the Metal plugin's results, not only
+// that it loads: a clear, a CPU upload copied by the GPU, a sampled draw, and a clear of an IOSurface-backed texture (what Core
+// Animation renders into), each read back and printed on stderr (stderr-log=1), one short line per write.
+#import <Foundation/Foundation.h>
+#import <IOSurface/IOSurface.h>
+#import <Metal/Metal.h>
+#include <stdio.h>
+#include <unistd.h>
+
+static void report(const char *what, const uint8_t *p)
+{
+    fprintf(stderr, "gpu-check: %s: %02x %02x %02x %02x | %02x %02x %02x %02x\n", what, p[0], p[1], p[2], p[3], p[4], p[5], p[6], p[7]);
+}
+
+static NSString *const kSource = @R"(
+#include <metal_stdlib>
+using namespace metal;
+struct V {float4 position [[position]]; float2 uv;};
+vertex V fullscreen(uint id [[vertex_id]]) {
+    float2 uv = float2((id << 1) & 2, id & 2);
+    return {float4(uv * float2(2, -2) + float2(-1, 1), 0, 1), uv};
+}
+fragment half4 copy(V in [[stage_in]], texture2d<half> source [[texture(0)]]) {
+    constexpr sampler nearest(filter::nearest);
+    return source.sample(nearest, in.uv);
+}
+)";
+
+int main(void)
+{
+    sleep(30);
+    @autoreleasepool {
+        id<MTLDevice> device = MTLCreateSystemDefaultDevice();
+        fprintf(stderr, "gpu-check: device %s\n", device ? device.name.UTF8String : "(none)");
+        if (!device)
+            return 1;
+        id<MTLCommandQueue> queue = [device newCommandQueue];
+        const NSUInteger n = 64;
+        MTLTextureDescriptor *d = [MTLTextureDescriptor texture2DDescriptorWithPixelFormat:MTLPixelFormatBGRA8Unorm width:n height:n
+                                                                                mipmapped:NO];
+        d.usage = MTLTextureUsageRenderTarget | MTLTextureUsageShaderRead;
+        d.storageMode = MTLStorageModeShared;
+        uint8_t pixels[64 * 64 * 4];
+
+        // 1: a clear
+        id<MTLTexture> cleared = [device newTextureWithDescriptor:d];
+        MTLRenderPassDescriptor *pass = [MTLRenderPassDescriptor renderPassDescriptor];
+        pass.colorAttachments[0].texture = cleared;
+        pass.colorAttachments[0].loadAction = MTLLoadActionClear;
+        pass.colorAttachments[0].storeAction = MTLStoreActionStore;
+        pass.colorAttachments[0].clearColor = MTLClearColorMake(0.25, 0.5, 0.75, 1.0);
+        id<MTLCommandBuffer> cb = [queue commandBuffer];
+        [[cb renderCommandEncoderWithDescriptor:pass] endEncoding];
+        [cb commit];
+        [cb waitUntilCompleted];
+        fprintf(stderr, "gpu-check: clear status %ld %s\n", (long)cb.status, cb.error ? cb.error.description.UTF8String : "");
+        memset(pixels, 0xee, sizeof pixels);
+        [cleared getBytes:pixels bytesPerRow:n * 4 fromRegion:MTLRegionMake2D(0, 0, n, n) mipmapLevel:0];
+        report("clear 0.25/0.5/0.75 (want bf 80 40 ff)", pixels);
+        report("clear, last pixels", pixels + sizeof pixels - 8);
+
+        // 2: a CPU upload, copied by the GPU
+        id<MTLTexture> uploaded = [device newTextureWithDescriptor:d];
+        for (NSUInteger i = 0; i < n * n; i++) {
+            pixels[4 * i] = 0x11; pixels[4 * i + 1] = 0x22; pixels[4 * i + 2] = 0x33; pixels[4 * i + 3] = 0xff;
+        }
+        [uploaded replaceRegion:MTLRegionMake2D(0, 0, n, n) mipmapLevel:0 withBytes:pixels bytesPerRow:n * 4];
+        id<MTLTexture> copied = [device newTextureWithDescriptor:d];
+        cb = [queue commandBuffer];
+        id<MTLBlitCommandEncoder> blit = [cb blitCommandEncoder];
+        [blit copyFromTexture:uploaded toTexture:copied];
+        [blit endEncoding];
+        [cb commit];
+        [cb waitUntilCompleted];
+        memset(pixels, 0xee, sizeof pixels);
+        [copied getBytes:pixels bytesPerRow:n * 4 fromRegion:MTLRegionMake2D(0, 0, n, n) mipmapLevel:0];
+        report("upload+blit (want 11 22 33 ff)", pixels);
+
+        // 3: a draw sampling the upload
+        NSError *error = nil;
+        id<MTLLibrary> library = [device newLibraryWithSource:kSource options:nil error:&error];
+        fprintf(stderr, "gpu-check: library %p %s\n", library, error ? error.description.UTF8String : "");
+        if (library) {
+            MTLRenderPipelineDescriptor *pd = [MTLRenderPipelineDescriptor new];
+            pd.vertexFunction = [library newFunctionWithName:@"fullscreen"];
+            pd.fragmentFunction = [library newFunctionWithName:@"copy"];
+            pd.colorAttachments[0].pixelFormat = MTLPixelFormatBGRA8Unorm;
+            id<MTLRenderPipelineState> pipeline = [device newRenderPipelineStateWithDescriptor:pd error:&error];
+            fprintf(stderr, "gpu-check: pipeline %p %s\n", pipeline, error ? error.description.UTF8String : "");
+            if (pipeline) {
+                id<MTLTexture> drawn = [device newTextureWithDescriptor:d];
+                pass.colorAttachments[0].texture = drawn;
+                pass.colorAttachments[0].clearColor = MTLClearColorMake(0, 0, 0, 0);
+                cb = [queue commandBuffer];
+                id<MTLRenderCommandEncoder> enc = [cb renderCommandEncoderWithDescriptor:pass];
+                [enc setRenderPipelineState:pipeline];
+                [enc setFragmentTexture:uploaded atIndex:0];
+                [enc drawPrimitives:MTLPrimitiveTypeTriangle vertexStart:0 vertexCount:3];
+                [enc endEncoding];
+                [cb commit];
+                [cb waitUntilCompleted];
+                memset(pixels, 0xee, sizeof pixels);
+                [drawn getBytes:pixels bytesPerRow:n * 4 fromRegion:MTLRegionMake2D(0, 0, n, n) mipmapLevel:0];
+                report("sampled draw (want 11 22 33 ff)", pixels);
+                report("sampled draw, centre", pixels + (32 * n + 32) * 4);
+            }
+        }
+
+        // 4: a clear of an IOSurface-backed texture, read through the surface's CPU mapping
+        NSDictionary *props = @{(id)kIOSurfaceWidth: @(n), (id)kIOSurfaceHeight: @(n), (id)kIOSurfaceBytesPerElement: @4,
+                                (id)kIOSurfacePixelFormat: @((uint32_t)'BGRA')};
+        IOSurfaceRef surface = IOSurfaceCreate((__bridge CFDictionaryRef)props);
+        if (surface) {
+            MTLTextureDescriptor *sd = [MTLTextureDescriptor texture2DDescriptorWithPixelFormat:MTLPixelFormatBGRA8Unorm width:n height:n
+                                                                                     mipmapped:NO];
+            sd.usage = MTLTextureUsageRenderTarget | MTLTextureUsageShaderRead;
+            id<MTLTexture> st = [device newTextureWithDescriptor:sd iosurface:surface plane:0];
+            fprintf(stderr, "gpu-check: surface texture %p\n", st);
+            if (st) {
+                pass.colorAttachments[0].texture = st;
+                pass.colorAttachments[0].clearColor = MTLClearColorMake(0.75, 0.5, 0.25, 1.0);
+                cb = [queue commandBuffer];
+                [[cb renderCommandEncoderWithDescriptor:pass] endEncoding];
+                [cb commit];
+                [cb waitUntilCompleted];
+                IOSurfaceLock(surface, kIOSurfaceLockReadOnly, NULL);
+                report("iosurface clear 0.75/0.5/0.25 (want 40 80 bf ff)", (const uint8_t *)IOSurfaceGetBaseAddress(surface));
+                IOSurfaceUnlock(surface, kIOSurfaceLockReadOnly, NULL);
+            }
+            CFRelease(surface);
+        }
+    }
+    fprintf(stderr, "gpu-check: done\n");
+    return 0;
+}
