From 6446cf7390091717bbc30972fcd0390aee0c189a Mon Sep 17 00:00:00 2001
From: k27 <k27@localhost>
Date: Wed, 25 Nov 2026 04:49:57 +0800
Subject: [PATCH] k27 0074: the App cryptex's System/Library as a read-only
 union view of /private/var/ngpu/app-library (sheng-gpu-addon=1, only when the
 source exists): Chrome's GPU sandbox maps code only from cryptex paths

---
 bsd/kern/kern_exec.c | 14 ++++++++++++++
 1 file changed, 14 insertions(+)

diff --git a/bsd/kern/kern_exec.c b/bsd/kern/kern_exec.c
index 5d02523..0431056 100644
--- a/bsd/kern/kern_exec.c
+++ b/bsd/kern/kern_exec.c
@@ -8296,6 +8296,8 @@ volatile int native_gpu_addon_stage = 0;
 volatile int native_gpu_addon_status = -1;
 volatile int native_gpu_addon2_stage = 0;
 volatile int native_gpu_addon2_status = -1;
+volatile int native_gpu_addon3_stage = 0;
+volatile int native_gpu_addon3_status = -1;
 static void
 native_gpu_addon_mount(proc_t p, user_addr_t scratch, user_addr_t offset, const char *source, size_t source_size,
     const char *point, size_t point_size, const char *visible, const char *own, volatile int *stage, volatile int *status)
@@ -8359,6 +8361,18 @@ native_gpu_addon_prepare(proc_t p, user_addr_t scratch)
 	native_gpu_addon_mount(p, scratch, 0x600, daemons_source, sizeof(daemons_source), daemons_point, sizeof(daemons_point),
 	    "/System/Library/LaunchDaemons/com.apple.backboardd.plist",
 	    "/System/Library/LaunchDaemons/org.blu-sharky.adrenoprobed.plist", &native_gpu_addon2_stage, &native_gpu_addon2_status);
+	/* piano 0074: the same kind of view over the App cryptex's System/Library, only when its source exists. Chrome's GPU sandbox maps
+	 * executable code only from the cryptex paths (/System/Volumes/Preboot/Cryptexes/App/System among them) and matches a symlink's real
+	 * path, so the plugin's code lives there (<source>/Extensions/<name>.bundle) and the /System/Library/Extensions view carries a symlink
+	 * to it. A missing source changes nothing (stage 1, ENOENT). */
+	static const char app_source[] = "/private/var/ngpu/app-library", app_point[] = "/System/Volumes/Preboot/Cryptexes/App/System/Library";
+	native_gpu_addon_mount(p, scratch, 0xa00, app_source, sizeof(app_source), app_point, sizeof(app_point),
+	    "/System/Volumes/Preboot/Cryptexes/App/System/Library/LaunchAgents",
+	    "/System/Volumes/Preboot/Cryptexes/App/System/Library/Extensions/NativeAdrenoMetal.bundle/Contents/Info.plist",
+	    &native_gpu_addon3_stage, &native_gpu_addon3_status);
+	printf("piano-gpu-addon: extensions stage %d status %d; daemons stage %d status %d; app-library stage %d status %d\n",
+	    native_gpu_addon_stage, native_gpu_addon_status, native_gpu_addon2_stage, native_gpu_addon2_status,
+	    native_gpu_addon3_stage, native_gpu_addon3_status);
 }
 
 #define NATIVE_OWNER_DATA_POINT "/System/Volumes/Data"   /* see native_owner_firmlinks_prepare */
-- 
2.56.1

