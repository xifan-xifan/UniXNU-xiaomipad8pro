From: Leo Zhang
Subject: [PATCH] k27: boot-gated panic text on the retained linear scanout

Requires 0069 panic-hold and 0071. Default off. No device I/O or allocation
in panic context; capture before the disabled console and render at hold.

diff --git a/osfmk/console/Makefile b/osfmk/console/Makefile
--- a/osfmk/console/Makefile
+++ b/osfmk/console/Makefile
@@ -9,6 +9,8 @@
 DATAFILES =
 
 PRIVATE_DATAFILES = \
+	piano_panic_text.h \
+	piano_panic_text_core.h \
 	piano_reset_reason.h \
 	video_console.h \
 	serial_protos.h
diff --git a/osfmk/console/video_console.c b/osfmk/console/video_console.c
--- a/osfmk/console/video_console.c
+++ b/osfmk/console/video_console.c
@@ -1,3 +1,6 @@
+#if defined(__arm64__) && defined(XNU_VM_GUEST)
+#include <console/piano_panic_text.h>
+#endif
 #include <kern/boot_progress.h>
 /*
  * Copyright (c) 2000-2020 Apple Inc. All rights reserved.
@@ -3310,3 +3313,30 @@
 }
 
 #endif /* defined(XNU_TARGET_OS_OSX) */
+
+#if defined(__arm64__) && defined(XNU_VM_GUEST)
+#include <console/piano_panic_text_core.h>
+static struct ppt_capture piano_text;
+static struct ppt_page piano_page;
+void piano_panic_text_begin(void)
+{
+    if (piano_panic_text_enabled)
+        (void)__atomic_exchange_n(&piano_text.active, 1u, __ATOMIC_RELAXED);
+}
+void piano_panic_text_putc(char c)
+{
+    if (!piano_panic_text_enabled || !__atomic_load_n(&piano_text.active, __ATOMIC_RELAXED)) return;
+    unsigned slot = __atomic_fetch_add(&piano_text.used, 1u, __ATOMIC_RELAXED);
+    if (slot < PPT_BYTES) piano_text.text[slot] = c;
+}
+void piano_panic_text_draw(void)
+{
+    if (!piano_panic_text_enabled) return;
+    unsigned n = __atomic_load_n(&piano_text.used, __ATOMIC_RELAXED);
+    if (n > PPT_BYTES) n = PPT_BYTES;
+    ppt_select(&piano_page, piano_text.text, n);
+    (void)ppt_render((volatile uint32_t *)vinfo.v_baseaddr, vinfo.v_width,
+        vinfo.v_height, vinfo.v_rowbytes, vinfo.v_depth, iso_font, &piano_page);
+    __builtin_arm_dsb(0xf);
+}
+#endif
