From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Leo Zhang
Date: Wed, 18 Nov 2026 00:00:00 +0800
Subject: [PATCH] k27: independent retained CVP reset reason before panic and reset

Reserve the last 64 KiB of CVP independently of the pstore ring. Read before
clear on the next native boot, recover eleven spaced copies by bitwise majority,
and validate epoch/session, version, final commit and CRC. Bounded lock-free
writers use separate first-event slots so panic survives its requested reboot.
No allocation, I/O, service lookup or USB drain in the record producer.

Record panic before debugger collection, and guard/timed/requested resets before
their reset or shutdown operations. Explicit watchdog fallback/test intent has its
own class; absent evidence is never diagnosed as a watchdog bite. A root-only,
boot-argument-gated sysctl panics for the two-boot RAM qualification.

The header and runtime are maintained/tested in tooling/k27/piano-reset-reason.
Requires a rebuilt native kernel. Relinking kexts against an older kernel cannot
install these call sites.
---
diff --git a/bsd/dev/arm64/sysctl.c b/bsd/dev/arm64/sysctl.c
--- a/bsd/dev/arm64/sysctl.c
+++ b/bsd/dev/arm64/sysctl.c
@@ -4,6 +4,11 @@
 #include <sys/param.h>
 #include <sys/kernel.h>
 #include <sys/sysctl.h>
+#include <sys/errno.h>
+#include <kern/debug.h>
+#if defined(XNU_VM_GUEST)
+#include <console/piano_reset_reason.h>
+#endif
 
 #include <machine/machine_routines.h>
 
@@ -21,6 +26,31 @@
 #if HYPERVISOR
 #include <kern/hv_support.h>
 #include <kern/bits.h>
+#endif
+
+
+#if defined(XNU_VM_GUEST)
+static int piano_reset_reason_pstore_size = PRR_PSTORE_BYTES;
+SYSCTL_INT(_machdep, OID_AUTO, piano_reset_reason_pstore_size,
+    CTLFLAG_RD | CTLFLAG_KERN | CTLFLAG_LOCKED, &piano_reset_reason_pstore_size, 0,
+    "CVP console extent with the retained reset tail reserved");
+/* 0071: no CTLFLAG_ANYBODY/KERN: the normal sysctl write gate requires root.
+ * The destructive test additionally needs both an armed record and its boot arg.
+ */
+static int
+sysctl_piano_reset_reason_test SYSCTL_HANDLER_ARGS
+{
+#pragma unused(arg1, arg2)
+	int value = piano_reset_reason_test_enabled() ? 1 : 0;
+	int err = sysctl_handle_int(oidp, &value, 0, req);
+	if (err || !req->newptr) return err;
+	if (!piano_reset_reason_test_enabled()) return EPERM;
+	if (value != 1) return EINVAL;
+	panic("diag-reason1 deliberate panic");
+}
+SYSCTL_PROC(_machdep, OID_AUTO, piano_reset_reason_test,
+    CTLTYPE_INT | CTLFLAG_RW | CTLFLAG_LOCKED, 0, 0,
+    sysctl_piano_reset_reason_test, "I", "root-only retained reset record panic test; boot-arg gated");
 #endif
 
 #define __STR(x)        #x
