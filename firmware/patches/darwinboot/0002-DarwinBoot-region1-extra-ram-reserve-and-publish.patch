+// The consumer can lower the stage with a boot argument. The firmware cap is stage 1.
+STATIC
+UINTN
+ExtraRamStage (CONST CHAR8 *CommandLine)
+{
+  STATIC CONST CHAR8 Key[] = "piano-extra-ram-stage=";
+  UINTN Stage = DARWIN_EXTRA_RAM_REGION0_STAGE;
+  for (CONST CHAR8 *Arg = CommandLine; *Arg != '\0'; ) {
+    CONST CHAR8 *End = Arg;
+    while (*End != '\0' && *End != ' ' && *End != '\t') { End++; }
+    if ((UINTN)(End - Arg) > sizeof (Key) - 1 && AsciiStrnCmp (Arg, Key, sizeof (Key) - 1) == 0) {
+      CONST CHAR8 *Value = Arg + sizeof (Key) - 1;
+      // XNU parses a number. All-zero spellings lower the cap; positive stages use the cap.
+      if (End - Value > 2 && Value[0] == '0' && (Value[1] == 'x' || Value[1] == 'X')) { Value += 2; }
+      while (Value < End && *Value == '0') { Value++; }
+      Stage = (Value == End) ? 0 : DARWIN_EXTRA_RAM_REGION0_STAGE;
+    }
+    Arg = (*End == '\0') ? End : End + 1;
+  }
+  return Stage;
+}
+
+STATIC
