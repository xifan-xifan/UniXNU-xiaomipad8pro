+  DARWIN_EXTRA_MAP_CHECK Check = {0};
+  for (UINTN Index = 0; Index + Stride <= Size; Index += Stride) {
+    EFI_MEMORY_DESCRIPTOR *Descriptor = (EFI_MEMORY_DESCRIPTOR *)((UINT8 *)Map + Index);
+    UINT64 End = Descriptor->PhysicalStart + EFI_PAGES_TO_SIZE (Descriptor->NumberOfPages);
+    if (DarwinExtraRamCheckDescriptor (&Check, &Allowed->run, Descriptor->PhysicalStart, End,
+                                      Descriptor->Type == EfiConventionalMemory, Descriptor->Type == EfiReservedMemoryType)) {
+      Print (L"DARWINBOOT: extra-ram %a map 0x%lx..0x%lx type=%u\n",
+             Allowed->name, Descriptor->PhysicalStart, End, Descriptor->Type);
+    }
+  }
+  return DarwinExtraRamDecision (&Check, &Allowed->run);
+}
