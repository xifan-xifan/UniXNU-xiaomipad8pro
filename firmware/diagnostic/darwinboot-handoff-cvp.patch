--- a/DarwinBootPkg/Driver/Entry.S
+++ b/DarwinBootPkg/Driver/Entry.S
@@ -5,10 +5,28 @@
   mrs x0, CurrentEL
   ret
 
+// Use a separate cache line for each stage, beside the existing EBS record.
+// x12/x13 are caller-saved and unused by the handoff. The CVP address is
+// identity-mapped under UEFI and is used physically after clearing SCTLR.M.
+.macro PianoHandoff stage, offset, clean
+  movz x12, #0x5000
+  movk x12, #0x9d1f, lsl #16
+  add x12, x12, #\offset
+  movz x13, #0x4844
+  movk x13, #0x5033, lsl #16
+  movk x13, #\stage, lsl #32
+  str x13, [x12]
+  .if \clean
+  dc cvac, x12
+  .endif
+  dsb sy
+.endm
+
 // x0=boot_args PA, x1=entry PA, x2=owned PA, x3=owned size, x4=frame buffer
 // PA (0 for none), x5=its size in bytes. EL1 only.
 ASM_FUNC(DarwinEnter)
   msr daifset, #15
+  PianoHandoff 1, 0x100, 1
   // Paint the top 1/16 of the framebuffer green (BGRA 0xFF00FF00)
   // before cache maintenance, MMU shutdown and the branch to the kernel.
   cbz x4, 2f
@@ -23,6 +41,7 @@
   b.hi 3b
   dsb sy
 2:
+  PianoHandoff 2, 0x200, 1
   add x5, x2, x3
   mrs x6, ctr_el0
   ubfx x6, x6, #16, #4
@@ -40,6 +59,7 @@
   ic iallu
   dsb sy
   isb
+  PianoHandoff 3, 0x300, 1
   mrs x4, sctlr_el1
   bic x4, x4, #1
   bic x4, x4, #4
@@ -49,4 +69,5 @@
   tlbi vmalle1
   dsb sy
   isb
+  PianoHandoff 4, 0x400, 0
   br x1
