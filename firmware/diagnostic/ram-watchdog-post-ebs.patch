+// This control exercises ExitBootServices without launching DarwinBoot or XNU.
+STATIC UINT64 mTrialMap[8192];
+
+STATIC
+VOID
+TrialExitBootServices (VOID)
+{
+  EFI_GRAPHICS_OUTPUT_PROTOCOL *Gop;
+  EFI_STATUS Status;
+  UINTN Size, Key, DescriptorSize, Attempt, Stride, Row, Column;
+  UINT32 Version;
+  UINT32 *Frame;
+
+  Status = gBS->LocateProtocol (&gEfiGraphicsOutputProtocolGuid, NULL, (VOID **)&Gop);
+  if (EFI_ERROR (Status) || Gop->Mode == NULL || Gop->Mode->Info == NULL ||
+      Gop->Mode->Info->PixelFormat >= PixelBitMask || Gop->Mode->FrameBufferBase == 0 ||
+      Gop->Mode->Info->HorizontalResolution < 128 ||
+      Gop->Mode->Info->VerticalResolution < 32) {
+    return;
+  }
+  Stride = Gop->Mode->Info->PixelsPerScanLine;
+  if (Stride < 128 || Gop->Mode->FrameBufferSize / sizeof (UINT32) / Stride < 32) {
+    return;
+  }
+  Frame = (UINT32 *)(UINTN)Gop->Mode->FrameBufferBase;
+  for (Attempt = 0; Attempt < 3; ++Attempt) {
+    Size = sizeof (mTrialMap);
+    Status = gBS->GetMemoryMap (&Size, (EFI_MEMORY_DESCRIPTOR *)mTrialMap, &Key, &DescriptorSize, &Version);
+    if (EFI_ERROR (Status)) {
+      break;
+    }
+    Status = gBS->ExitBootServices (gImageHandle, Key);
+    if (!EFI_ERROR (Status)) {
+      // Green and magenta are invariant under RGB/BGR channel order.
+      for (Row = 0; Row < 32; ++Row) {
+        for (Column = 0; Column < 128; ++Column) {
+          ((volatile UINT32 *)Frame)[Row * Stride + Column] = Column < 64 ? 0x0000ff00 : 0x00ff00ff;
+        }
+        WriteBackDataCacheRange (Frame + Row * Stride, 128 * sizeof (UINT32));
+      }
+      break;
+    }
+    if (Status != EFI_INVALID_PARAMETER) {
+      break;
+    }
+  }
+  // The independently armed firmware watchdog is the only reset path here.
+  CpuDeadLoop ();
+}
