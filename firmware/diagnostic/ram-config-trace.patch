+STATIC
+VOID
+TraceRamPayload (
+  IN EFI_HANDLE Volume
+  )
+{
+  EFI_BLOCK_IO_PROTOCOL *BlockIo;
+  EFI_STATUS Status;
+  UINT8 Sector[512];
+  UINT32 Crc;
+
+  Status = gBS->HandleProtocol (Volume, &gEfiBlockIoProtocolGuid, (VOID **)&BlockIo);
+  UniXNULog ("config: matched RAM handle %p, Block I/O %r", Volume, Status);
+  if (EFI_ERROR (Status) || (BlockIo->Media == NULL)) {
+    return;
+  }
+
+  UniXNULog ("config: RAM block size %u align %u readonly %u", BlockIo->Media->BlockSize,
+             BlockIo->Media->IoAlign, BlockIo->Media->ReadOnly);
+  if ((BlockIo->Media->BlockSize != sizeof (Sector)) || (BlockIo->Media->IoAlign > 1)) {
+    return;
+  }
+
+  Status = BlockIo->ReadBlocks (BlockIo, BlockIo->Media->MediaId, 0, sizeof (Sector), Sector);
+  UniXNULog ("config: RAM LBA 0 read %r", Status);
+  if (!EFI_ERROR (Status)) {
+    Status = gBS->CalculateCrc32 (Sector, sizeof (Sector), &Crc);
+    if (!EFI_ERROR (Status)) {
+      UniXNULog ("config: RAM LBA 0 crc32 %08x signature %02x%02x", Crc, Sector[510], Sector[511]);
+    }
+  }
+}
