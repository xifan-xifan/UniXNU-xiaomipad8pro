--- a/uefi/pianoPkg/Library/DeviceBootManagerLib/DeviceBootManager.c
+++ b/uefi/pianoPkg/Library/DeviceBootManagerLib/DeviceBootManager.c
@@ -41,6 +41,29 @@
 EFIAPI
 DeviceBootManagerAfterConsole ()
 {
+  UINT64 CurrentEl;
+
+  __asm__ volatile ("mrs %0, CurrentEL" : "=r" (CurrentEl));
+  DEBUG ((DEBUG_ERROR, "piano watchdog trial: EL%u\n", (UINT32)(CurrentEl >> 2)));
+  if (CurrentEl == 4) {
+    register UINT64 X0 __asm__("x0") = 0x86000006;
+    register UINT64 X1 __asm__("x1") = 0;
+    register UINT64 X2 __asm__("x2") = 0;
+    register UINT64 X3 __asm__("x3") = 0;
+    __asm__ volatile ("smc #0" : "+r" (X0), "+r" (X1), "+r" (X2), "+r" (X3) : : "x4", "x5", "x6", "x7", "x8", "x9", "x10", "x11", "x12", "x13", "x14", "x15", "x16", "x17", "memory");
+    DEBUG ((DEBUG_ERROR, "piano watchdog trial: STATUS=%Lx\n", X0));
+    if (X0 == 0) {
+      X0 = 0x86000008; X1 = 30000; X2 = 32000; X3 = 0;
+      __asm__ volatile ("smc #0" : "+r" (X0), "+r" (X1), "+r" (X2), "+r" (X3) : : "x4", "x5", "x6", "x7", "x8", "x9", "x10", "x11", "x12", "x13", "x14", "x15", "x16", "x17", "memory");
+      DEBUG ((DEBUG_ERROR, "piano watchdog trial: SET_TIME=%Lx\n", X0));
+      if (X0 == 0) {
+        X0 = 0x86000005; X1 = 3; X2 = 0; X3 = 0;
+        __asm__ volatile ("smc #0" : "+r" (X0), "+r" (X1), "+r" (X2), "+r" (X3) : : "x4", "x5", "x6", "x7", "x8", "x9", "x10", "x11", "x12", "x13", "x14", "x15", "x16", "x17", "memory");
+        DEBUG ((DEBUG_ERROR, "piano watchdog trial: ENABLE=%Lx; no pet armed\n", X0));
+      }
+    }
+  }
+
   PianoFastbootStart (); 
   return NULL;
 }
