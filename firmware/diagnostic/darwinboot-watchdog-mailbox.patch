+// Diagnostic-only checkpoint in the piano CVP carveout. Keep eleven page-
+// separated copies so the host can identify the stage after a warm reset.
+STATIC
+VOID
+RecordPianoExit (UINT32 Stage, UINTN Attempt, EFI_STATUS Status)
+{
+  for (UINTN Copy = 0; Copy < 11; ++Copy) {
+    volatile UINT64 *Record = (volatile UINT64 *)(UINTN)(0x9D1F5000 + Copy * 0x1000);
+    Record[0] = 0x315342454F4E4150ULL; // PANO EBS1, little endian
+    Record[1] = ((UINT64)Attempt << 32) | Stage;
+    Record[2] = Status;
+    Record[3] = ~Record[1];
+    WriteBackDataCacheRange ((VOID *)(UINTN)Record, 4 * sizeof (UINT64));
+  }
+  __asm__ volatile ("dsb sy" ::: "memory");
+}
 
